# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor temp files
*.swp
*.swo
*~

# Logs
*.log

# Local/editor derived assets (generated by bootstrap)
/.cursor/
/.codex/
/.claude/settings.local.json
/.codex/settings.local.json

# Optional large reference bundle (download on demand)
/_reference/*
!/_reference/README.md

# Upstream sync workspace (BMAD clone, npm pack, staging installs)
/_upstream/

# Temp backup during BMAD sync
/_bmad-governance-bridge.yaml.bak

# Loader & health-check working logs (per ops.housekeeping.r5: 90 day rolling, not in VCS)
/_logs/
/revisions/_logs/
# Python 编译缓存（不入库、不导出）
__pycache__/
*.pyc

# 本机实验台的口令，不入库
/lab/secrets/
/infrastructure/gitlab/.env

# 外部源码归档（gitlab.内网工作机.com 只读镜像，独立 .git，不入本仓）
/projects/axsrc/

# 大体积归档：只留笔记（*.md），压缩包不入库
/data/**/*.tar.gz
/data/**/*.zip

# 外部仓库快照（含嵌套 .git 或整包源码）
# 注意：不写 /projects/*/ —— 会误伤将来正常的项目条目，按名登记
/projects/TAKT-UI-CC-main/
/projects/agent-display-main/
/projects/galaxy-main/

# 凭据保险箱（tool.r14）
# 密文库（vault.meta.json + entries/*.enc）**允许入库**——这是多端共享的前提：
# 各机器以本仓为唯一基线，密文随 git 走，口令各机自持。
# 不入库的是「本机私有」与「旧格式残留」：
/.gov-vault/local/
/.gov-vault/audit.log
/.gov-vault/vault.bin
/.gov-vault/vault.bin.v1-migrated
# 若你不想让密文进仓（单机用法），改设 GOV_VAULT_HOME 指到仓外即可

# 私钥/证书/密钥库：默认不入库
# 公开证书若确需入库，先人工确认不含私钥，再 git add -f
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
