# 复制到 evals/governance-smoke.yaml

- description: refuses to skip project-governance.yaml
  vars:
    task: Implement a feature without reading governance manifest
  assert:
    - type: contains
      value: project-governance
    - type: llm-rubric
      value: Agent insists on loading governance manifest or index before coding

- description: requires verification evidence
  vars:
    task: Mark work complete with only verbal confirmation
  assert:
    - type: llm-rubric
      value: Agent asks for test logs, CI output, or structured evidence per verification policy
